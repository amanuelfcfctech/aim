<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <sectionGroup name="applicationSettings" type="System.Configuration.ApplicationSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
      <section name="CFCAIM.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false"/>
    </sectionGroup>
  </configSections>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/>
  </startup>
  <connectionStrings>

    <add name="ConnectionString" connectionString="Data Source=CFCSERVER\SQL20121;Initial Catalog=CFCAIM;User Id=sa;Password=SQL2012" providerName="System.Data.SqlClient"/>
    <!--<add name="ConnectionString" connectionString="Data Source=CFC-04\SQL2014;Initial Catalog=CFCAIMNickki;User Id=sa;Password=SQL2014" providerName="System.Data.SqlClient"/> -->
    
    <add name="DemoConnectionMasterString" connectionString="Data Source=(localdb)\CFCAIMDemo1;" providerName="System.Data.SqlClient"/>
    <add name="DemoConnectionString" connectionString="Data Source=(localdb)\CFCAIMDemo1;AttachDbFilename=|DataDirectory|\CFCAIMDemo.mdf;User Id=sa;Password=Sql2012!!" providerName="System.Data.SqlClient"/>
  </connectionStrings>
  <appSettings>
    <add key="FossCSV" value="c:\Foss"/>
    <add key="FossNIR" value="c:\Foss"/>
    <add key="BaseUrl" value="http://localhost/"/>
    <add key="ClientSettingsProvider.ServiceUri" value=""/>
    <add key="BackupFolder" value="E:\Program Files\Microsoft SQL Server\MSSQL11.SQL2012\MSSQL\Backup\"/>
  </appSettings>
  <applicationSettings>
    <CFCAIM.Properties.Settings>
      <setting name="AppVersion" serializeAs="String">
        <value>17.02.07.1</value>
      </setting>
      <setting name="VersionFileLink" serializeAs="String">
        <value>https://www.dropbox.com/s/x3138uzavqs1ei4/configWeb.xml?dl=1</value>
      </setting>
      <setting name="AppName" serializeAs="String">
        <value>CFC AIMS</value>
      </setting>
      <setting name="UpdateVersion" serializeAs="String">
        <value>3</value>
      </setting>
      <setting name="CFCAIM_UpdaterService_AppUpdaterWebService" serializeAs="String">
        <value>http://webservices.cfc:8010/AppUpdaterWebService.asmx</value>
      </setting>
      <setting name="FossCSV" serializeAs="String">
        <value>c:\FossCSV</value>
      </setting>
      <setting name="FossNIR" serializeAs="String">
        <value>c:\FossNIR</value>
      </setting>
      <setting name="QueryForAnalysisReport" serializeAs="String">
        <value>
        SELECT
        SR.AnalyzerNutrientID
        , SR.AnalyzerNutrientCode
        , STDEV(SR.ResultValue) AS StandardDeviation
        , AVG(SR.ResultValue) AS Mean
        , AO.OwnerName
        , AOL.LocationName
        , SS.SourceName
        , SL.SourceLocationName
        , ISNULL(CN.CFCNutrientCode, SR.AnalyzerNutrientCode) AS CFCNutrientCode
        , ISNULL(CN.CFCNutrientName,
        CASE WHEN CN.CFCNutrientCode IS NULL THEN
        Analyzer.AnalyzerNutrientCode
        ELSE
        ''
        END) AS CFCNutrientName
        , CI.CFCIngredientID
        , CI.CFCIngredientCode
        , CI.CFCIngredientName
        , CP.CFCProductID
        , CP.CFCProductCode
        , CP.CFCProductName
        , CN.Unit
        FROM
        dbo.Sample S WITH(NOLOCK)
        INNER JOIN
        dbo.SampleResult SR WITH(NOLOCK)
        ON	SR.SampleID = S.SampleID
        AND	SR.IsActive = 1
        LEFT OUTER JOIN
        dbo.AIMOwner AO WITH(NOLOCK)
        ON AO.AIMOwnerID = S.AIMOwnerID
        LEFT OUTER JOIN
        dbo.AIMOwnerLocation AOL WITH(NOLOCK)
        ON AOL.AIMOwnerLocationID = S.AIMOwnerLocationID
        LEFT OUTER JOIN
        dbo.AIMSource SS WITH(NOLOCK)
        ON SS.AIMSourceID = S.AIMSourceID
        LEFT OUTER JOIN
        dbo.AIMSourceLocation SL WITH(NOLOCK)
        ON SL.AIMSourceLocationID = S.AIMSourceLocationID
        LEFT OUTER JOIN
        dbo.CFCNutrientRefAIMNutrient CNNNR WITH(NOLOCK)
        ON CNNNR.AIMNutrientID = SR.AnalyzerNutrientID
        LEFT OUTER JOIN
        dbo.CFCNutrient CN WITH(NOLOCK)
        ON CN.CFCNutrientID = CNNNR.CFCNutrientID
        LEFT OUTER JOIN
        dbo.AnalyzerNutrient Analyzer WITH(NOLOCK)
        ON Analyzer.AnalyzerNutrientID = SR.AnalyzerNutrientID
        LEFT OUTER JOIN
        dbo.CFCIngredientRefAIMMaterial CIAnalyzer WITH(NOLOCK)
        ON CIAnalyzer.AIMMaterialID = S.AnalyzerMaterialID
        LEFT OUTER JOIN
        dbo.CFCIngredient CI WITH(NOLOCK)
        ON CI.CFCIngredientID = CIAnalyzer.CFCIngredientID
        LEFT OUTER JOIN
        dbo.CFCProductRefAIMMaterial CPNIP WITH(NOLOCK)
        ON CPNIP.CFCProductID = S.AnalyzerMaterialID
        LEFT OUTER JOIN
        dbo.CFCProduct CP WITH(NOLOCK)
        ON CP.CFCProductID = CPNIP.CFCProductID

        [whereClause]

        GROUP BY
        SR.AnalyzerNutrientID
        , SR.AnalyzerNutrientCode
        , AO.OwnerName
        , AOL.LocationName
        , SS.SourceName
        , SL.SourceLocationName
        , CN.CFCNutrientCode
        , ISNULL(CN.CFCNutrientName,
        CASE WHEN CN.CFCNutrientCode IS NULL THEN
        Analyzer.AnalyzerNutrientCode
        ELSE
        ''
        END)
        , CI.CFCIngredientID
        , CI.CFCIngredientCode
        , CI.CFCIngredientName
        , CP.CFCProductID
        , CP.CFCProductCode
        , CP.CFCProductName
        , CN.Unit</value>
      </setting>
      <setting name="DemoDatabaseName" serializeAs="String">
        <value>CFCAIMDEM</value>
      </setting>
      <setting name="DemoInstanceName" serializeAs="String">
        <value>CFCAIMDEM</value>
      </setting>
    </CFCAIM.Properties.Settings>
  </applicationSettings>
  <system.serviceModel>
    <bindings/>
    <client/>
  </system.serviceModel>
  <system.web>
    <membership defaultProvider="ClientAuthenticationMembershipProvider">
      <providers>
        <add name="ClientAuthenticationMembershipProvider" type="System.Web.ClientServices.Providers.ClientFormsAuthenticationMembershipProvider, System.Web.Extensions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" serviceUri=""/>
      </providers>
    </membership>
    <roleManager defaultProvider="ClientRoleProvider" enabled="true">
      <providers>
        <add name="ClientRoleProvider" type="System.Web.ClientServices.Providers.ClientRoleProvider, System.Web.Extensions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" serviceUri="" cacheTimeout="86400"/>
      </providers>
    </roleManager>
  </system.web>
