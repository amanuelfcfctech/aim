using System.Drawing;



namespace CFCAIM.ReportDevExpress
{
    public partial class SampleLabelReport : DevExpress.XtraReports.UI.XtraReport
    {
        public SampleLabelReport()
        {
            InitializeComponent();            
        }

        //6/30/21
        private void SampleLabelReport_BeforePrint(object sender, System.Drawing.Printing.PrintEventArgs e)
        {
            //Line1
            if (AIMGlobal.line1Bold == true) { xrLabelCaption1.Font = new Font(xrLabelCaption1.Font.FontFamily, xrLabelCaption1.Font.Size, FontStyle.Bold); }
            if (AIMGlobal.line1Bold == true) { xrLabelField1.Font = new Font(xrLabelField1.Font.FontFamily, xrLabelField1.Font.Size, FontStyle.Bold); }
                                  
            //Line2
            if (AIMGlobal.line2Bold == true) { xrLabelCaption2.Font = new Font(xrLabelCaption2.Font.FontFamily, xrLabelCaption2.Font.Size, FontStyle.Bold); }
            if (AIMGlobal.line2Bold == true) { xrLabelField2.Font = new Font(xrLabelField2.Font.FontFamily, xrLabelField2.Font.Size, FontStyle.Bold); }

            //Line3
            if (AIMGlobal.line3Bold == true) { xrLabelCaption3.Font = new Font(xrLabelCaption3.Font.FontFamily, xrLabelCaption3.Font.Size, FontStyle.Bold); }
            if (AIMGlobal.line3Bold == true) { xrLabelField3.Font = new Font(xrLabelField3.Font.FontFamily, xrLabelField3.Font.Size, FontStyle.Bold); }

            //Line4
            if (AIMGlobal.line4Bold == true) { xrLabelCaption4.Font = new Font(xrLabelCaption4.Font.FontFamily, xrLabelCaption4.Font.Size, FontStyle.Bold); }
            if (AIMGlobal.line4Bold == true) { xrLabelField4.Font = new Font(xrLabelField4.Font.FontFamily, xrLabelField4.Font.Size, FontStyle.Bold); }

            //Line5
            if (AIMGlobal.line5Bold == true) { xrLabelCaption5.Font = new Font(xrLabelCaption5.Font.FontFamily, xrLabelCaption5.Font.Size, FontStyle.Bold); }
            if (AIMGlobal.line5Bold == true) { xrLabelField5.Font = new Font(xrLabelField5.Font.FontFamily, xrLabelField5.Font.Size, FontStyle.Bold); }
        }

    }
}
